{
  "name": "pentest-report-app",
  "version": "1.0.0",
  "description": "Penetration Testing Report Generator - Full Stack Application",
  "main": "server/server.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "node server/server.js"
  },
  "keywords": ["pentest", "security", "reporting"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "docxtemplater": "^3.42.3",
    "pizzip": "^3.1.6",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
